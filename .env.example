# Docker development credentials only; replace before deployment.
POSTGRES_PASSWORD=apbwas
DATABASE_URL=postgresql+psycopg://apbwas:apbwas@postgres:5432/apbwas
# Optional separate SELECT-only role for business tools. Empty still enforces
# PostgreSQL READ ONLY transactions and 2500 ms statement timeout.
AGENT_DATABASE_URL=
REDIS_URL=redis://redis:6379/0
DEMO_MODE=true
DEMO_PASSWORD=Demo@123456
PROVIDER=openai
AI_MODEL=gpt-4o-mini
# For Intern AI or another explicitly trusted OpenAI-compatible provider:
# PROVIDER=openai_compatible
# AI_MODEL=deepseek-v4-flash-vision
AI_BASE_URL=
AI_API_KEY=
AI_PROVIDER_LABEL=
AI_JSON_MODE=true
AI_TIMEOUT_SECONDS=45
# Set true when real AI operates on existing sample business data.
SAMPLE_DATA=true
# Empty follows chat provider. Use lexical explicitly for sample documents when
# the chat service has no embeddings API; lexical is not semantic retrieval.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
GEMINI_API_KEY=
AUDIT_KEY=demo-audit-key-change-in-connected-mode
COOKIE_SECURE=false
FRONTEND_PORT=4180
FRONTEND_ORIGIN=http://localhost:4180
UPLOAD_DIR=/app/uploads
# Additional model IDs approved for Agent Builder (same backend provider/credentials).
AGENT_MODELS=
# Gmail OAuth: enable Gmail API, create a Web application OAuth Client.
GMAIL_SENDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4180/mail/callback
# Fernet key; generate once and back it up separately from the database.
MAIL_ENCRYPTION_KEY=
# Application cap per APBWAS sender over a rolling 24 hours (not Google's quota).
MAIL_BULK_DAILY_LIMIT=100
# Optional dedicated Fernet key for LLM credentials. Empty reuses MAIL_ENCRYPTION_KEY.
LLM_ENCRYPTION_KEY=
