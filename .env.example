# Docker development credentials only; replace before deployment.
POSTGRES_PASSWORD=apbwas
DATABASE_URL=postgresql+psycopg://apbwas:apbwas@postgres:5432/apbwas
# Optional separate SELECT-only role for business tools. Empty still enforces
# PostgreSQL READ ONLY transactions and 2500 ms statement timeout.
AGENT_DATABASE_URL=
REDIS_URL=redis://redis:6379/0
DEMO_MODE=true
DEMO_PASSWORD=Demo@123456
PROVIDER=openai
AI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
GEMINI_API_KEY=
AUDIT_KEY=demo-audit-key-change-in-connected-mode
COOKIE_SECURE=false
FRONTEND_PORT=4180
FRONTEND_ORIGIN=http://localhost:4180
UPLOAD_DIR=/app/uploads
