legend [shape=plain,pos="31.944444444444443,3.4722222222222223!",pin=true,label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="10"><TR><TD><B>Chen notation</B></TD></TR><TR><TD ALIGN="LEFT">Rectangle = entity · oval = attribute · diamond = relationship</TD></TR><TR><TD ALIGN="LEFT">Underlined attribute = primary key</TD></TR><TR><TD ALIGN="LEFT">1 = exactly one · 0..1 = optional one · 0..N = zero or many</TD></TR><TR><TD ALIGN="LEFT">Only declared foreign keys form relationships.</TD></TR></TABLE>>];
