legend [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLPADDING="6"><TR><TD><B>Notation</B></TD></TR><TR><TD ALIGN="LEFT">PK primary key · FK foreign key · UQ unique · ? nullable</TD></TR><TR><TD ALIGN="LEFT">Crow foot = many · circle = optional · bar = one</TD></TR><TR><TD ALIGN="LEFT">permissions, audit_logs, system_settings, jobs have no FK.</TD></TR><TR><TD ALIGN="LEFT">JSON references are not foreign keys.</TD></TR></TABLE>>];
