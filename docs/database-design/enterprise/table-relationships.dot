digraph schema {
graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.4", ranksep="1.0", splines=polyline, label="Nova Commerce / APBWAS - migration 0003", labelloc=t, fontsize=22];
node [shape=plain,fontname="Arial"];
edge [color="#65748b",arrowsize=0.65,fontname="Arial",fontsize=9];
audit_logs [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="2" BGCOLOR="#dfe6ff"><B>audit_logs</B></TD></TR><TR><TD PORT="id_w" ALIGN="LEFT">id PK</TD><TD PORT="id_e" ALIGN="LEFT">INTEGER</TD></TR><TR><TD PORT="created_at_w" ALIGN="LEFT">created_at </TD><TD PORT="created_at_e" ALIGN="LEFT">TIMESTAMP WITH TIME ZONE</TD></TR><TR><TD PORT="actor_w" ALIGN="LEFT">actor </TD><TD PORT="actor_e" ALIGN="LEFT">VARCHAR(80)</TD></TR><TR><TD PORT="event_w" ALIGN="LEFT">event </TD><TD PORT="event_e" ALIGN="LEFT">VARCHAR(80)</TD></TR><TR><TD PORT="resource_w" ALIGN="LEFT">resource </TD><TD PORT="resource_e" ALIGN="LEFT">VARCHAR(80)</TD></TR><TR><TD PORT="correlation_id_w" ALIGN="LEFT">correlation_id </TD><TD PORT="correlation_id_e" ALIGN="LEFT">VARCHAR(80)</TD></TR><TR><TD PORT="payload_w" ALIGN="LEFT">payload </TD><TD PORT="payload_e" ALIGN="LEFT">JSON</TD></TR><TR><TD PORT="previous_hash_w" ALIGN="LEFT">previous_hash </TD><TD PORT="previous_hash_e" ALIGN="LEFT">VARCHAR(64)</TD></TR><TR><TD PORT="hash_w" ALIGN="LEFT">hash </TD><TD PORT="hash_e" ALIGN="LEFT">VARCHAR(64)</TD></TR></TABLE>>];
